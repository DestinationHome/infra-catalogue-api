# Server Listening Configuration
HOST=0.0.0.0
PORT=8080

# MongoDB Connection String (must specify default database name at the end)
MONGO_URI=mongodb://localhost:27017/catalogue

# JWT Authentication Private Key
JWT_PRIVATE_KEY=your_jwt_private_key_here

# (Optional) Meilisearch Engine URL
# If set, search queries are routed to Meilisearch for typo-tolerant full-text search & facets.
# If unset or unreachable, the API automatically falls back to MongoDB aggregation.
MEILI_URL=http://localhost:7700

# Logging Filter
RUST_LOG=info,catalogue=debug
